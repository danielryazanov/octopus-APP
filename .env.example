# ── Application ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASS
MONGO_APP_USER=appuser
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASS

# Ports (can be changed to avoid conflicts)
NGINX_PORT=80
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS

# Production image (used by docker-compose.prod.yml)
APP_IMAGE=ghcr.io/danielryazanov/octopus-app:latest
